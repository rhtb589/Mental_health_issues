# ===========================================
# Mental Health Care - Environment Variables
# Copy to .env and fill in real values. All keys are REQUIRED in production.
# ===========================================

# --- Application ---
MHC_APP_NAME=Mental Health Screening App
MHC_ENVIRONMENT=dev
MHC_API_PREFIX=/api/v1
MHC_LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
MHC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mhcare

# --- Auth ---
MHC_JWT_SECRET=replace-with-long-random-string
MHC_JWT_ALGORITHM=HS256
MHC_ACCESS_TOKEN_TTL_MINUTES=30
MHC_REFRESH_TOKEN_TTL_DAYS=7
MHC_BCRYPT_SCHEMES=bcrypt

# --- Field-level encryption for sensitive health data ---
# Generate with: python -c "from app.security.encryption import generate_key; print(generate_key())"
MHC_FIELD_ENCRYPTION_KEY=replace-with-fernet-key

# --- Privacy / data residency (store in India by default) ---
MHC_DATA_RESIDENCY_REGION=in
MHC_DATA_TRANSFER_DISCLOSED=false

# --- Consent text versions presented to users ---
MHC_CONSENT_TEXT_VERSION=2024-08-01
MHC_RESEARCH_CONSENT_TEXT_VERSION=2024-08-01

# --- Retention (years) ---
MHC_IDENTIFIABLE_RETENTION_YEARS=5
MHC_HIGH_RISK_RETENTION_YEARS=7
MHC_AUDIT_LOG_RETENTION_YEARS=3
MHC_INACTIVE_GRACE_DAYS=365

# --- RBAC ---
MHC_DEFAULT_ROLE=patient

# --- CORS ---
MHC_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ===========================================
# ML / AI Dependencies
# ===========================================

# --- Ollama (LLM & Embeddings) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Qdrant (Vector Store) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=mental_health_docs

# --- ChromaDB (Vector Store) ---
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=mental_health_docs

# --- Sentence Transformers (Embeddings) ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- ML Model Paths ---
MODEL_PATH=./ml_ai/prediction/models
SCIKIT_LEARN_MODEL_PATH=./ml_ai/prediction/models/baseline
XGBOOST_MODEL_PATH=./ml_ai/prediction/models/xgboost
LIGHTGBM_MODEL_PATH=./ml_ai/prediction/models/lightgbm

# --- Hugging Face (for transformers, tokenizers) ---
HF_HOME=./ml_ai/cache/huggingface
TRANSFORMERS_CACHE=./ml_ai/cache/transformers

# --- PyTorch ---
TORCH_DEVICE=cpu

# --- TensorFlow ---
TF_CPP_MIN_LOG_LEVEL=2

# --- LangChain ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=mental-health-care

# --- RAG Pipeline ---
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# --- Safety Pipeline ---
SAFETY_CRISIS_THRESHOLD=0.8
SAFETY_MODEL_PATH=./ml_ai/safety/models
SAFETY_FLAGGED_KEYWORDS=["suicide","kill myself","end my life","self harm"]
